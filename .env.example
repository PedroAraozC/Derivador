VITE_APP_RUTA_BACK=http://localhost:3050

# A dónde vuelve cada aplicación externa después del ingreso, con el token en
# el parámetro `auth`. La clave de la izquierda en APPS_EXTERNAS (Login.jsx) es
# el valor de `next`: /login?next=urbania vuelve a la primera, y
# /login?next=elcop a la segunda.
#
# En producción son los dominios de cada aplicación, no localhost.
VITE_APP_URBANIA_CALLBACK_URL=http://localhost:3000/auth/cidituc/callback
VITE_APP_ELCOP_CALLBACK_URL=http://localhost:3000/auth/cidituc/callback
